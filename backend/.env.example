# ---- core ----
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://shikshak:shikshak@postgres:5432/shikshak
REDIS_URL=redis://:dev-only-redis-password-change-me@redis:6379/0
MEDIA_ROOT=/data/media
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ---- content provider ----
CONTENT_PROVIDER=fixture            # fixture | notebooklm
MCP_ENDPOINT=http://mcp:7332
MCP_TIMEOUT_TEXT_SEC=360
MCP_TIMEOUT_AUDIO_SEC=1200
MAX_MODULE_FANOUT=2

# ---- auth ----
ADMIN_SESSION_TTL_HOURS=8
STUDENT_SESSION_TTL_DAYS=30
LOGIN_RATE_LIMIT=100/15m           # failed logins per client IP (sliding window)
LOGIN_FAILURE_WINDOW_SEC=900       # window for per-email / per-device failure counts
LOGIN_FREE_FAILURES=5              # per email: failures before the growing delay starts
LOGIN_DEVICE_FREE_FAILURES=10      # per trusted device: the same
LOGIN_DELAY_BASE_SEC=2             # delay after the first counted failure, doubling…
LOGIN_DELAY_MAX_SEC=60             # …up to this
# signs the trusted-device cookie; random, >= 32 characters, required outside dev
DEVICE_COOKIE_SECRET=dev-only-device-cookie-secret-change-me
DEVICE_COOKIE_MAX_AGE_DAYS=180
REGISTER_RATE_LIMIT=100/1h         # register attempts per client IP
PASSWORD_RESET_RATE_LIMIT=30/1h    # reset requests per client IP (per email: 3/h, silent)
PASSWORD_RESET_ENABLED=true

# ---- email (optional, dev uses MailHog) ----
# smtp://host:port | smtp://user:pass@host:587?starttls=true | smtps://user:pass@host
# (outside dev: DATABASE_URL must not use the dev password, PUBLIC_BASE_URL and
#  DEVICE_COOKIE_SECRET must be set; in prod SMTP_URL must not be mailhog while PASSWORD_RESET_ENABLED=true)
SMTP_URL=smtp://mailhog:1025
EMAIL_FROM=no-reply@shikshak.local

# ---- observability ----
SENTRY_DSN=

# ---- celery ----
CELERY_BROKER_URL=redis://:dev-only-redis-password-change-me@redis:6379/1
CELERY_RESULT_BACKEND=redis://:dev-only-redis-password-change-me@redis:6379/2
