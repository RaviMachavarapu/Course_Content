# ---- core ----
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://shikshak:shikshak@postgres:5432/shikshak
REDIS_URL=redis://redis:6379/0
MEDIA_ROOT=/data/media
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ---- content provider ----
CONTENT_PROVIDER=fixture            # fixture | notebooklm
MCP_ENDPOINT=http://mcp:7332
MCP_TIMEOUT_TEXT_SEC=360
MCP_TIMEOUT_AUDIO_SEC=1200
MAX_MODULE_FANOUT=2

# ---- auth ----
ADMIN_SESSION_TTL_HOURS=8
STUDENT_SESSION_TTL_DAYS=30
LOGIN_RATE_LIMIT=10/5m             # failed logins per client IP and per email
REGISTER_RATE_LIMIT=30/1h          # register attempts per client IP
PASSWORD_RESET_RATE_LIMIT=10/1h    # reset requests per client IP (per email: 3/h, silent)
PASSWORD_RESET_ENABLED=true

# ---- email (optional, dev uses MailHog) ----
# smtp://host:port | smtp://user:pass@host:587?starttls=true | smtps://user:pass@host
# (outside dev: DATABASE_URL must not use the dev password and PUBLIC_BASE_URL must
#  be set; in prod SMTP_URL must not be mailhog while PASSWORD_RESET_ENABLED=true)
SMTP_URL=smtp://mailhog:1025
EMAIL_FROM=no-reply@shikshak.local

# ---- observability ----
SENTRY_DSN=

# ---- celery ----
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
