#!/bin/sh
# Print fresh random secrets for the root .env (see .env.example). Nothing is
# written: paste the output into .env, or for a new file:
#   scripts/gen-secrets > .env.secrets && cat .env.example .env.secrets > .env
# (then delete the <generate> lines). Values are URL-safe (they go into the
# database and Redis URLs). Needs python3, or openssl as a fallback.
set -eu

gen() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import secrets, sys; print(secrets.token_urlsafe(int(sys.argv[1])))' "$1"
  else
    openssl rand -base64 "$(( $1 * 2 ))" | tr -d '\n=' | tr '+/' '-_' | cut -c1-"$(( $1 * 4 / 3 ))"
    echo
  fi
}

echo "POSTGRES_PASSWORD=$(gen 32)"
echo "REDIS_PASSWORD=$(gen 32)"
echo "DEVICE_COOKIE_SECRET=$(gen 48)"
