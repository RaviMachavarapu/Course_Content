# Root .env for docker compose (git-ignored). Compose reads it for the ${VAR}
# values in docker-compose.yml; anything left out keeps its dev default.
#
# Dev needs no .env at all. For staging/prod copy this file to .env, fill in
# every value, and generate the secrets with:
#   scripts/gen-secrets            (prints POSTGRES_PASSWORD, REDIS_PASSWORD,
#                                   DEVICE_COOKIE_SECRET lines to paste here)
# With APP_ENV other than dev the backend refuses to start on any dev or
# missing value. See "Production checklist" in README.md.

APP_ENV=prod

# ---- secrets (generate; URL-safe characters only: they sit inside URLs) ----
# POSTGRES_PASSWORD only takes effect when the pgdata volume is first created.
POSTGRES_PASSWORD=<generate>
REDIS_PASSWORD=<generate>
# >= 32 characters; signs the trusted-device login cookie
DEVICE_COOKIE_SECRET=<generate>

# ---- public address (https; the login cookies are Secure outside dev) ----
PUBLIC_BASE_URL=https://learn.example.org
CORS_ORIGINS=https://learn.example.org

# ---- password-reset mail ----
# smtp://user:pass@host:587?starttls=true | smtps://user:pass@host
SMTP_URL=smtps://<user>:<password>@<smtp-host>
EMAIL_FROM=no-reply@learn.example.org
# or turn password reset off instead of configuring SMTP:
# PASSWORD_RESET_ENABLED=false

# ---- login / sign-up limits (the compose defaults are loose, for e2e runs) ----
LOGIN_RATE_LIMIT=100/15m
REGISTER_RATE_LIMIT=100/1h
PASSWORD_RESET_RATE_LIMIT=30/1h

# ---- observability (optional) ----
SENTRY_DSN=
